# Shared sweep shape — keep identical across all three arms.
CONCURRENCIES="1 2 4 8"
LENGTHS="128:128 2048:256 8192:256"
MODEL_CONFIG=/models/Ornith-1.0-35B-MXFP4/config.json
# Arc Pro B70 peak BF16 TFLOPS for MFU (set from the datasheet; 0 = skip MFU).
PEAK_BF16_TFLOPS=0
# Optional override if flops.py's config-derived active-param count is off.
ACTIVE_PARAMS_B=0

# Arm G/E: point at whatever 05 is serving (examples).
# ARM=G BASE_URL=http://127.0.0.1:8004 MODEL=ornith
# ARM=E BASE_URL=http://127.0.0.1:8004 MODEL=ornith

# Arm O
ARM_O_IMAGE=hal/vllm-xpu:kris-fork-577e1a932-rebuild
MODEL_HOST=/models/Ornith-1.0-35B-MXFP4
# Profile-consistency: match 05's serve profile.
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=2
GPU_UTIL=0.85
KV_CACHE_DTYPE=fp8
